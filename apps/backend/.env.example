# STT - Deepgram (live Flux + batch Nova-3)
DEEPGRAM_API_KEY=your_deepgram_api_key

# STT - choix du fournisseur (défaut : deepgram)
# STT_LIVE_PROVIDER=deepgram   # modèle par défaut (deepgram | inworld) ; l'interface permet d'en choisir un par session
# STT_BATCH_PROVIDER=deepgram  # modèle par défaut des cours (deepgram | inworld) ; l'écran d'import permet d'en choisir un par cours
# FFMPEG_PATH=/usr/bin/ffmpeg  # optionnel : binaire ffmpeg pour Inworld (cours) ; sinon celui de ffmpeg-static

# STT - Inworld
# La clé rend Inworld sélectionnable dans le menu de l'interface (elle est aussi
# requise si STT_LIVE_PROVIDER=inworld). Sans clé, Inworld reste grisé.
# EXPERIMENTAL : validé sur un enregistrement de cours (auth, prompts, forme des
# erreurs) mais pas encore sur un entretien ; les sessions "zh" sont rejetées
# avec un session:error (pas de streaming chinois).
# Clé "Basic (Base64)" de https://platform.inworld.ai/api-keys
# INWORLD_API_KEY=your_inworld_basic_base64_key

# LLM - Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173
